{
  "name": "smartstudy-ai-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "backend",
    "web",
    "mobile",
    "shared",
    "firebase"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:web": "npm run dev --workspace=web",
    "build:web": "npm run build --workspace=web",
    "build:backend": "npm run build --workspace=backend",
    "typecheck": "npm run typecheck --workspace=web",
    "build": "npm run build:web && npm run build:backend",
    "test": "npm test --workspace=web",
    "test:coverage": "npm test --workspace=web",
    "test:selenium": "node selenium-tests/runner.js",
    "report:selenium": "python selenium-tests/reporter.py",
    "test:appium": "node appium-tests/runner.js",
    "test:security": "node scripts/run-security-audit.js",
    "test:k6:smoke": "k6 run --summary-trend-stats \"avg,min,med,max,p(90),p(95),p(99)\" -e MODE=smoke performance-tests/k6-baseline.js",
    "test:k6": "k6 run --summary-trend-stats \"avg,min,med,max,p(90),p(95),p(99)\" -e MODE=baseline performance-tests/k6-baseline.js",
    "test:k6:api": "k6 run --summary-trend-stats \"avg,min,med,max,p(90),p(95),p(99)\" performance-tests/k6-api-baseline.js",
    "test:pipeline": "node scripts/run-test-pipeline.js",
    "test:pipeline:smoke": "node scripts/run-test-pipeline.js --smoke-only"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "selenium-webdriver": "^4.47.0"
  }
}
